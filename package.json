{
  "name": "rc-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm build:packages && pnpm lint && pnpm typecheck && pnpm build",
    "dev": "pnpm build:packages && pnpm --recursive --parallel --filter \"./apps/*\" dev",
    "dev:app": "pnpm --filter @workspace/app dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "dev:api": "pnpm --filter @workspace/api dev",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "db:up": "docker compose up --detach --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm build:packages && pnpm --filter @workspace/api build && pnpm --filter @workspace/api db:migrate",
    "db:seed": "pnpm build:packages && pnpm --filter @workspace/api build && pnpm --filter @workspace/api db:seed",
    "deploy:staging": "sst deploy --stage staging",
    "deploy:production": "sst deploy --stage production"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sst": "4.17.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
