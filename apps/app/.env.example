# Environment variables for the web application (apps/app).
# Copy to `.env` in this folder for local development. Never commit real values.
# Production values are set in sst.config.ts (see docs/DEPLOY.md).

# Public URL of the app (used for metadata, sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of apps/api, for the browser (sign in / sign out) and for the server (data).
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Server-only variables: declare them in src/lib/env.ts too.

# Show "Continue with Google" on /sign-in. Turn it on only when the API has GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
