# Environment variables for the API (apps/api). Copy to `.env` in this folder for local development.
# Never commit real values. Production values come from infra/ and SSM Parameter Store (see docs/DEPLOY.md).
# Every variable is validated in src/env.ts.

# Local database started with `pnpm db:up` (Docker).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-secret-change-me-0123456789

# Events engine (`pnpm engine`): folder for the raw pages and feeds it reads. Git-ignored.
ENGINE_SNAPSHOT_DIR=.snapshots

# Email: "log" prints each message to the console (local), "ses" sends it with Amazon SES.
MAIL_TRANSPORT=log
MAIL_FROM="SunTzu RC <hello@suntzurc.com>"
# The AWS project's region (SES, S3, Bedrock).
AWS_REGION=us-east-2

# Sign in with Google (optional): Google Cloud console → APIs & Services → Credentials → OAuth
# client ID (web). Authorised redirect URI: <API_URL>/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated emails of the crew: those accounts get the crew role (review console).
CREW_EMAILS=
# Where the crew hears about new messages and "try it" requests (optional).
# CREW_INBOX=

# Cloudflare Turnstile secret (production): public forms are refused without a valid token.
# TURNSTILE_SECRET_KEY=

# AI extraction of events from pasted text: Claude on Amazon Bedrock, in AWS_REGION. Turn on model
# access in the Bedrock console first. Without it, pasted text goes to the crew's inbox.
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
