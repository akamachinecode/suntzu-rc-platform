{
  "name": "@workspace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsc -p tsconfig.build.json",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:node": "node --watch --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json && node dist/openapi.js",
    "start": "node dist/migrate.js && node dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@workspace/db": "workspace:*",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.7.12",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
