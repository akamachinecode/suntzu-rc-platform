{
  "name": "@workspace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsc -p tsconfig.build.json",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:node": "node --watch --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json && node dist/openapi.js",
    "start": "node dist/migrate.js && node dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js",
    "engine": "node --env-file-if-exists=.env dist/engine.js",
    "census": "node --env-file-if-exists=.env dist/census.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notify": "node --env-file-if-exists=.env dist/notify.js"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.0",
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@workspace/db": "workspace:*",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.7.15",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
