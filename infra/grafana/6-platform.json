    {
      "type": "timeseries",
      "title": "Descargas de imágenes (ECR)",
      "description": "Cada vez que un contenedor arranca descarga su imagen: despliegues, reinicios y cada tarea programada.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
