    {
      "type": "timeseries",
      "title": "Logs ingeridos por grupo",
      "description": "Bytes que entran en CloudWatch Logs cada hora. Es lo que más crece con el tráfico (0,50 USD por GB ingerido). aws/spans son las trazas.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/Logs",
          "metricName": "IncomingBytes",
          "dimensions": {
            "LogGroupName": "*"
          },
          "statistic": "Sum",
          "period": "3600",
          "matchExact": false,
          "label": "${PROP('Dim.LogGroupName')}",
          "id": "",
          "expression": "",
          "hide": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
