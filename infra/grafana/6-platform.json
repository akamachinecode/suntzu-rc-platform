          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/ECR",
          "metricName": "RepositoryPullCount",
          "dimensions": {
            "RepositoryName": "*"
          },
          "statistic": "Sum",
          "period": "3600",
          "matchExact": false,
          "label": "${PROP('Dim.RepositoryName')}",
          "id": "",
          "expression": "",
          "hide": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "gradientMode": "opacity",
