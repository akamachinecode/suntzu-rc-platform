        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Llamadas a CloudWatch",
      "description": "Llamadas a la API de CloudWatch por tipo. GetMetricData son sobre todo las de este Grafana: 0,01 USD por cada 1.000 métricas leídas.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/Usage",
          "metricName": "CallCount",
          "dimensions": {
            "Service": "CloudWatch",
            "Type": "API",
            "Class": "None",
            "Resource": "*"
          },
          "statistic": "Sum",
          "period": "3600",
          "matchExact": false,
          "label": "${PROP('Dim.Resource')}",
          "id": "",
          "expression": "",
          "hide": false,
          "refId": "A"
