  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Plataforma: el resto de la cuenta\nLas piezas que no se ven en la web pero la sostienen: el programador de tareas, el registro de imágenes, la ingesta de logs (lo que cuesta CloudWatch Logs) y las llamadas a la API de CloudWatch (lo que cuesta este Grafana)."
      },
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "Tareas e imágenes",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Arranques del programador",
      "description": "Cada vez que EventBridge Scheduler intenta arrancar una tarea (engine 4 al día, notify cada hora, census una vez al mes).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/Scheduler",
          "metricName": "InvocationAttemptCount",
          "dimensions": {},
          "statistic": "Sum",
          "period": "3600",
          "matchExact": true,
          "label": "",
          "id": "raw16",
          "expression": "",
          "hide": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "us-east-2",
          "expression": "FILL(raw16, 0)",
          "label": "intentos",
          "id": "filled16",
          "period": "",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "statistic": "Average",
          "hide": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/Scheduler",
          "metricName": "TargetErrorCount",
          "dimensions": {},
          "statistic": "Sum",
          "period": "3600",
          "matchExact": true,
          "label": "",
          "id": "raw17",
          "expression": "",
          "hide": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "us-east-2",
          "expression": "FILL(raw17, 0)",
          "label": "errores",
          "id": "filled17",
          "period": "",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "statistic": "Average",
          "hide": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/Scheduler",
          "metricName": "InvocationDroppedCount",
          "dimensions": {},
          "statistic": "Sum",
          "period": "3600",
          "matchExact": true,
          "label": "",
          "id": "raw18",
          "expression": "",
          "hide": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${ds}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "us-east-2",
          "expression": "FILL(raw18, 0)",
          "label": "descartados",
          "id": "filled18",
          "period": "",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "statistic": "Average",
          "hide": false,
          "refId": "F"
        }
