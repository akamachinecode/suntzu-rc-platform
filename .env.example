# Environment variables for Rc Landing.
# Copy to `.env` for local development. Never commit real values.
# Production values are configured in the hosting provider (see docs/DEPLOY.md).

# Public URL of the app (used for metadata, sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only variables: declare them in src/lib/env.ts too.
# DATABASE_URL=

# Deploy credentials (only needed to run `sst deploy` from your machine).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_DEFAULT_ACCOUNT_ID=
