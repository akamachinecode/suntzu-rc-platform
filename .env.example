# Environment variables for Servo.
# Copy to `.env` for local development. Never commit real values.
# Production values are configured in the hosting provider (see docs/DEPLOY.md).

# Each app reads its own variables: see apps/api/.env.example and apps/app/.env.example.

# Deploy credentials (only needed to run `sst deploy` from your machine).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_DEFAULT_ACCOUNT_ID=
