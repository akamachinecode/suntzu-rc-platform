{
  "name": "@workspace/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed client for apps/api, generated from apps/api/openapi.json. Used by apps/app (and a future mobile app).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json --output src/schema.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@workspace/api": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
